# Backend service env for docker-compose. Copy to deploy/env/backend.env
CAUSALGUARD_LOG_LEVEL=INFO

# Telemetry source: simulated | prometheus | postgres | auto
CAUSALGUARD_TELEMETRY__SOURCE_MODE=simulated
CAUSALGUARD_TELEMETRY__PROMETHEUS_URL=http://prometheus:9090
CAUSALGUARD_TELEMETRY__PROMETHEUS_DATNAME=production_db

# Point the postgres source at the in-stack primary (read-only monitor role):
CAUSALGUARD_POSTGRES__DSN=postgresql://causalguard_monitor:monitor_secret@postgres-primary:5432/production_db
CAUSALGUARD_POSTGRES__MONITORED_TABLE=orders

# Real sandbox against the in-stack throwaway database:
CAUSALGUARD_SANDBOX__MODE=simulated
CAUSALGUARD_SANDBOX__DSN=postgresql://causalguard:causalguard_secret@postgres-primary:5432/sandbox_db
CAUSALGUARD_SANDBOX__ALLOW_DESTRUCTIVE=false
CAUSALGUARD_SANDBOX__ALLOW_PRIMARY=false

# Comma-separated API keys (empty disables auth). Generate with `openssl rand -hex 24`.
CAUSALGUARD_SECURITY__API_KEYS=
CAUSALGUARD_SECURITY__RATE_LIMIT_PER_MINUTE=240
