# CausalGuard configuration — copy to `.env` and edit.
# Every value here has a safe default; nothing is required to boot in simulated mode.
# Nested keys use a double underscore:  CAUSALGUARD_<SECTION>__<KEY>

# ----- core -----------------------------------------------------------------
CAUSALGUARD_ENVIRONMENT=development           # development | staging | production | test
CAUSALGUARD_LOG_LEVEL=INFO
CAUSALGUARD_LOG_FORMAT=console                # console (dev) | json (prod)

# ----- server -------------------------------------------------------------
CAUSALGUARD_SERVER__HOST=0.0.0.0
CAUSALGUARD_SERVER__PORT=8000
CAUSALGUARD_SERVER__WORKERS=1
CAUSALGUARD_SERVER__CORS_ORIGINS=http://localhost:5173,http://localhost:8080
CAUSALGUARD_SERVER__TRUSTED_HOSTS=*

# ----- telemetry source -------------------------------------------------
# simulated | prometheus | postgres | auto
CAUSALGUARD_TELEMETRY__SOURCE_MODE=simulated
CAUSALGUARD_TELEMETRY__FALLBACK_TO_SIMULATED=true
CAUSALGUARD_TELEMETRY__PROMETHEUS_URL=http://localhost:9090
CAUSALGUARD_TELEMETRY__PROMETHEUS_RELNAME=orders
CAUSALGUARD_TELEMETRY__PROMETHEUS_DATNAME=production_db
CAUSALGUARD_TELEMETRY__STREAM_INTERVAL_SECONDS=2.0

# ----- monitored PostgreSQL (source_mode=postgres) --------------------
# CAUSALGUARD_POSTGRES__DSN=postgresql://causalguard_monitor:monitor_secret@localhost:5432/production_db
CAUSALGUARD_POSTGRES__SCHEMA_NAME=public
CAUSALGUARD_POSTGRES__MONITORED_TABLE=orders

# ----- real sandbox (empirical intervention verification) ------------
CAUSALGUARD_SANDBOX__MODE=simulated           # simulated | real
# CAUSALGUARD_SANDBOX__DSN=postgresql://causalguard:causalguard_secret@localhost:5432/sandbox_db
CAUSALGUARD_SANDBOX__ALLOW_DESTRUCTIVE=false  # required for VACUUM / pg_terminate_backend
CAUSALGUARD_SANDBOX__ALLOW_PRIMARY=false      # hard guard: never touch prod

# ----- persistence -----------------------------------------------------
CAUSALGUARD_DATABASE__URL=sqlite+aiosqlite:///./data/causalguard.db
# CAUSALGUARD_DATABASE__URL=postgresql+asyncpg://causalguard:causalguard_secret@localhost:5432/causalguard
CAUSALGUARD_DATABASE__RETENTION_DOSSIERS=500

# ----- security ------------------------------------------------------
# Comma-separated bearer/x-api-key values. Empty = auth disabled.
CAUSALGUARD_SECURITY__API_KEYS=
CAUSALGUARD_SECURITY__REQUIRE_AUTH_FOR_MUTATIONS=false
CAUSALGUARD_SECURITY__RATE_LIMIT_PER_MINUTE=240
CAUSALGUARD_SECURITY__HSTS_ENABLED=false

# ----- AMD ROCm ----------------------------------------------------
CAUSALGUARD_ROCM__ENABLED=true
CAUSALGUARD_ROCM__DEVICE_ID=0
CAUSALGUARD_ROCM__PRECISION=BF16              # BF16 | FP16 | FP8 | INT8
CAUSALGUARD_ROCM__USE_AITER=false
